NODE_API_URL=http://localhost:4000
SERVICE_TOKEN=dev-service-token-change-me
# Vision LLM used by AI 1 and AI 5. Without a key the service still runs using OCR text and regex only,
# and infrastructure results fall back to "needs_more_evidence".
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
OCR_ENGINE=paddle   # paddle | tesseract | none
