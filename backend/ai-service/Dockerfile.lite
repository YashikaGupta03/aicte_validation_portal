FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10

# tesseract: OCR | libzbar0: QR codes | libglib2.0-0: OpenCV | curl: healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr libzbar0 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements-lite.txt .
RUN pip install -r requirements-lite.txt

RUN useradd -m svc && chown -R svc /srv
COPY --chown=svc app ./app
USER svc

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD curl -fs http://127.0.0.1:8000/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]