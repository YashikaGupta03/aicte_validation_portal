# Shared by docker-compose. Generate real secrets: openssl rand -hex 32
NODE_ENV=development
JWT_SECRET=dev-only-change-me
SERVICE_TOKEN=dev-service-token-change-me
CORS_ORIGIN=http://localhost:5173
AUTO_APPROVE_COLLEGES=true
# Optional: enables the vision LLM for AI 1 (reading) and AI 5 (infrastructure)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
OCR_ENGINE=paddle
# Optional SMTP for email alerts (empty = log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=validation@example.org
