NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/aicte_validation
REDIS_URL=redis://localhost:6379
# Change both in any shared or deployed environment (the server refuses to start in production with defaults)
JWT_SECRET=dev-only-change-me
SERVICE_TOKEN=dev-service-token-change-me
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Python AI service (called by the worker) and the URL the AI service uses to call back into this API
AI_SERVICE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:4000
# Demo convenience: colleges are active right after sign-up. Set false to require admin approval.
AUTO_APPROVE_COLLEGES=true
# Run the BullMQ worker inside the API process (dev). In Docker the worker runs as its own container.
RUN_WORKER_IN_API=true
MAX_UPLOAD_MB=15
# Email alerts. Leave SMTP_HOST empty to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=validation@example.org
